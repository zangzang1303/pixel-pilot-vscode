{
  "name": "pixel-pilot-vscode",
  "displayName": "Pixel Pilot",
  "description": "All-in-one AI Image Studio & Visual Assistant: Local InvokeAI T2I, Background Removal, Upscaling, Vectorize SVG, Inpainting & Code Auto-Insert.",
  "version": "1.1.0",
  "publisher": "pixel-pilot-team",
  "repository": {
    "type": "git",
    "url": "https://github.com/zangzang1303/pixel-pilot-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "image-studio",
    "invokeai",
    "remove-background",
    "stable-diffusion",
    "upscale",
    "inpaint"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "webview-ui/dist/**",
    "media/**",
    "scripts/**",
    "README.md",
    "START_PIXEL_PILOT.cmd"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:pixelPilot.sidebarView",
    "onCommand:pixel-pilot.openStudio",
    "onCommand:pixelPilot.openStudio",
    "onCommand:pixel-pilot.upscaleImage",
    "onCommand:pixelPilot.upscaleImage",
    "onCommand:pixelPilot.removeBackground",
    "onCommand:pixelPilot.vectorizeImage",
    "onCommand:pixelPilot.batchProcessFolder",
    "onCommand:pixelPilot.startComfyUI"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pixel-pilot",
          "title": "Pixel Pilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pixel-pilot": [
        {
          "type": "webview",
          "id": "pixelPilot.sidebarView",
          "name": "AI Studio Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "pixel-pilot.openStudio",
        "title": "Pixel Pilot: Open AI Studio (Canvas)",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixelPilot.openSidebar",
        "title": "Pixel Pilot: Open Sidebar Assistant",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixel-pilot.upscaleImage",
        "title": "Pixel Pilot: Upscale Image (2x)",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixelPilot.removeBackground",
        "title": "Pixel Pilot: Remove Background (BiRefNet)",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixelPilot.vectorizeImage",
        "title": "Pixel Pilot: Vectorize to SVG",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixelPilot.batchProcessFolder",
        "title": "Pixel Pilot: Batch Process Folder...",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixelPilot.setApiKey",
        "title": "Pixel Pilot: Configure AI API Key",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixelPilot.clearApiKey",
        "title": "Pixel Pilot: Clear API Key",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixelPilot.clearCache",
        "title": "Pixel Pilot: Clear Disk Cache",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixel-pilot.checkStatus",
        "title": "Pixel Pilot: Check InvokeAI Server Status",
        "category": "Pixel Pilot"
      },
      {
        "command": "pixelPilot.startComfyUI",
        "title": "Pixel Pilot: Khởi động ComfyUI Local GPU (Port 8188)",
        "category": "Pixel Pilot"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pixel-pilot.openStudio",
          "when": "resourceExtname =~ /\\.(png|jpe?g|webp|bmp)$/i",
          "group": "pixelPilot@1"
        },
        {
          "command": "pixelPilot.removeBackground",
          "when": "resourceExtname =~ /\\.(png|jpe?g|webp|bmp)$/i",
          "group": "pixelPilot@2"
        },
        {
          "command": "pixel-pilot.upscaleImage",
          "when": "resourceExtname =~ /\\.(png|jpe?g|webp|bmp)$/i",
          "group": "pixelPilot@3"
        },
        {
          "command": "pixelPilot.vectorizeImage",
          "when": "resourceExtname =~ /\\.(png|jpe?g|webp|bmp)$/i",
          "group": "pixelPilot@4"
        },
        {
          "command": "pixelPilot.batchProcessFolder",
          "when": "explorerResourceIsFolder",
          "group": "pixelPilot@5"
        }
      ]
    },
    "configuration": {
      "title": "Pixel Pilot (AI Studio)",
      "properties": {
        "pixelPilot.invokeAIServerUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9090",
          "description": "Local InvokeAI server instance URL (default: http://127.0.0.1:9090)."
        }
      }
    }
  },
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_pixel_pilot.ps1",
    "start:real": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_pixel_pilot.ps1 -NoMock",
    "start:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_pixel_pilot.ps1 -StartComfyUI",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop_pixel_pilot.ps1",
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "mock:invokeai": "node scripts/mock_invokeai.mjs",
    "build:webview": "npm --prefix webview-ui run build",
    "build": "npm run build:webview && npm run compile",
    "test": "npm run compile && node --test test/*.test.cjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sharp": "^0.31.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
