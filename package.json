{
  "name": "pixel-pilot-vscode",
  "displayName": "Pixel Pilot - Visual AI Studio for VS Code",
  "description": "Context-Aware Visual AI Assistant & Multi-Task SOTA Vision Studio for Developers (Matting, Vectorize, Inpaint, Upscale, DAG History)",
  "version": "1.0.0",
  "publisher": "pixel-pilot-team",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixel-pilot/pixel-pilot-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "vision",
    "remove-background",
    "matting",
    "birefnet",
    "vectorize",
    "upscale",
    "inpaint",
    "dag",
    "context-aware"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:pixelPilot.sidebarView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pixel-pilot",
          "title": "Pixel Pilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pixel-pilot": [
        {
          "type": "webview",
          "id": "pixelPilot.sidebarView",
          "name": "Pixel Pilot AI Studio"
        }
      ]
    },
    "commands": [
      {
        "command": "pixelPilot.openSidebar",
        "title": "Pixel Pilot: Open AI Studio Sidebar"
      },
      {
        "command": "pixelPilot.removeBackground",
        "title": "Pixel Pilot: Remove Background (BiRefNet 1-Click)"
      },
      {
        "command": "pixelPilot.upscaleImage",
        "title": "Pixel Pilot: Upscale Image (2x/4x Super-Resolution)"
      },
      {
        "command": "pixelPilot.vectorizeImage",
        "title": "Pixel Pilot: Vectorize to SVG"
      },
      {
        "command": "pixelPilot.newSession",
        "title": "Pixel Pilot: New Session"
      },
      {
        "command": "pixelPilot.setApiKey",
        "title": "Pixel Pilot: Set Runware API Key (Encrypted SecretStorage)"
      },
      {
        "command": "pixelPilot.clearApiKey",
        "title": "Pixel Pilot: Xóa API Key khỏi SecretStorage"
      },
      {
        "command": "pixelPilot.batchProcessFolder",
        "title": "Pixel Pilot Enterprise: Xử lý Hàng loạt (Batch Process Assets...)"
      },
      {
        "command": "pixelPilot.initEnterpriseConfig",
        "title": "Pixel Pilot Enterprise: Khởi tạo Cấu hình Chuẩn Doanh nghiệp (.pixelpilotrc.json)"
      },
      {
        "command": "pixelPilot.clearCache",
        "title": "Pixel Pilot Enterprise: Dọn dẹp Bộ nhớ Cache Đĩa cứng"
      },
      {
        "command": "pixelPilot.moveToRightSide",
        "title": "Pixel Pilot: Chuyển sang Sidebar bên phải (Codex View)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pixelPilot.removeBackground",
          "when": "resourceExtname =~ /\\.(png|jpe?g|webp|bmp)$/i",
          "group": "pixelPilot@1"
        },
        {
          "command": "pixelPilot.vectorizeImage",
          "when": "resourceExtname =~ /\\.(png|jpe?g|webp|bmp)$/i",
          "group": "pixelPilot@2"
        },
        {
          "command": "pixelPilot.upscaleImage",
          "when": "resourceExtname =~ /\\.(png|jpe?g|webp|bmp)$/i",
          "group": "pixelPilot@3"
        },
        {
          "command": "pixelPilot.batchProcessFolder",
          "when": "explorerResourceIsFolder",
          "group": "pixelPilot@4"
        }
      ]
    },
    "configuration": {
      "title": "Pixel Pilot",
      "properties": {
        "pixelPilot.apiKey": {
          "type": "string",
          "default": "",
          "description": "Runware API Key for Cloud Vision Inference"
        },
        "pixelPilot.offlineMode": {
          "type": "boolean",
          "default": false,
          "description": "Use Local Simulation Mode (Offline Mock Engine for defense & testing)"
        },
        "pixelPilot.autoSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically save output images alongside the original image"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "benchmark": "node benchmark/run_benchmark.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
